# Copy to .env and fill in before `docker compose up`
# Secret used to sign in to the web UI and call /api/keys (Bearer)
LICENSE_ADMIN_TOKEN=change-me-long-random-string
# Public base URL of this service; shown in the UI as the panel's license_server_url
LICENSE_PUBLIC_URL=https://license.yourdomain.com
DOMAIN=license.vietpanel.trongtri.com
